    <!-- 1. 存储访问 -->
    <string name="set_section_storage_access">Storage access</string>
    <string name="set_storage_granted_desc">On: ordinary folders work without Shizuku; Android/data still needs Shizuku.</string>
    <string name="set_storage_not_granted_desc">Off: turn it on to move between ordinary folders without Shizuku; Android/data still needs Shizuku.</string>
    <string name="set_storage_granted">Granted</string>
    <string name="set_storage_open">Open “All files access”</string>
    <string name="set_help_storage_access">Lets Shitu move photos between ordinary folders. With all-files access on, Shizuku isn’t needed for those; Android/data still needs Shizuku.</string>

    <!-- 2. 运行条件 -->
    <string name="set_section_run_conditions">Run conditions</string>
    <string name="set_run_conditions_desc">Top to bottom, first match wins: allow conditions (charging / screen on / locked) let it move; block conditions (locked too long / low battery) stop it. Charging on top = charging priority. All off = move any time.</string>
    <string name="set_run_only_charging">While charging</string>
    <string name="set_run_only_screen_on">While the screen is on</string>
    <string name="set_run_only_screen_off">While locked</string>
    <string name="set_run_min_battery">Don’t move below %1$d%% battery</string>
    <string name="set_run_min_battery_off">Don’t move below X% battery</string>
    <string name="set_run_min_battery_pct">Battery threshold</string>
    <string name="set_run_lock_timeout_on">Stop after %1$d min locked</string>
    <string name="set_run_lock_timeout_off">Stop after X min locked</string>
    <string name="set_run_lock_timeout_min">Locked duration (minutes)</string>
    <string name="set_help_run_conditions">Conditions are checked top to bottom; the first match wins. Charging on top means charging always wins; put low battery or lock timeout above it to block charging too.</string>
    <string name="set_help_run_charging">Move only while charging. Put it above low battery / lock timeout to make charging override them.</string>
    <string name="set_help_run_screen_on">Move only while the screen is on and unlocked. The first matching condition wins.</string>
    <string name="set_help_run_screen_off">Move only while locked/screen off. If lock timeout is above it, moving stops after the timeout.</string>
    <string name="set_help_run_battery">Stop below the set battery level. If charging is above it, charging overrides this limit. Range 1–100.</string>

    <!-- 3. 检测时机 -->
    <string name="set_section_detection_timing">Detection timing</string>
    <string name="set_fast_while_active">Speed up while the screen is on</string>
    <string name="set_fast_interval_sec">Check interval (sec)</string>
    <string name="set_fast_while_active_desc">Peeks at source folders every few seconds while the screen is on.</string>
    <string name="set_settle_detect">Move as soon as writing finishes</string>
    <string name="set_settle_gap_sec">Write-finished window (sec)</string>
    <string name="set_settle_detect_desc">Moves it as soon as size and modified time stop changing.</string>
    <string name="set_help_detection">How often source folders are checked, and how soon a finished file is moved.</string>
    <string name="set_help_fast_while_active">While the screen is on, peeks at folders every few seconds; a full scan runs only when something changed.</string>
    <string name="set_help_settle_detect">Moves a file as soon as its size and modified time stop changing, without waiting out the settle time.</string>

