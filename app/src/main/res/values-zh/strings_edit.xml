<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 规则编辑页（中文）。与 values/strings_edit.xml 的 key 一一对应，文案照抄自原界面。 -->

    <!-- 标题与提醒 -->
    <string name="edit_title_new">新建规则</string>
    <string name="edit_title_edit">编辑规则</string>
    <string name="edit_conflicts_title">配置提醒</string>

    <!-- 规则与源目录 -->
    <string name="edit_section_rule_src">规则与源目录</string>
    <string name="edit_label_name">规则名称</string>
    <string name="edit_placeholder_name">给它起个名字，比如「起点封面」</string>
    <string name="edit_label_src">源目录（从这里把图片搬走）</string>
    <string name="edit_placeholder_dir">点右边「选择」，从 /sdcard 开始挑</string>
    <string name="edit_pick">选择</string>
    <string name="edit_src_empty_hint">还没选。点「选择」从 /sdcard 开始，一层层点进图片所在的文件夹</string>
    <string name="edit_src_root_hint">这是整个存储根目录，会搬走手机里几乎所有图片</string>
    <string name="edit_src_all_app_data_hint">这是所有 App 的数据根目录，会搬走各个 App 里的图片；建议点「选择」往下选到具体那个 App</string>
    <string name="edit_src_hint">从 /sdcard 开始往下点，选到具体的图片文件夹最安全</string>
    <string name="edit_include_subdirs">包含子目录</string>
    <string name="edit_subdirs_on_hint">会把源目录下面所有层级的图片都搬走</string>
    <string name="edit_subdirs_dst_inside">；注意目标目录就在源目录里面，会把刚搬进去的文件又当成源</string>
    <string name="edit_subdirs_off_hint">只搬源目录这一层里的图片，子文件夹不看（目标目录在源目录里时更安全）</string>
    <string name="edit_label_max_depth">最大深度（留空 = 不限）</string>

    <!-- 目标与模式 -->
    <string name="edit_section_dst_mode">目标与模式</string>
    <string name="edit_label_dst">目标目录（搬到这里）</string>
    <string name="edit_dst_hint">建议放在 DCIM 或 Pictures 下，相册才能立刻看到</string>
    <string name="edit_mode_move">移动</string>
    <string name="edit_mode_copy">复制</string>
    <string name="edit_mode_move_hint">移动：源文件会被搬到目标目录（推荐）</string>
    <string name="edit_mode_copy_hint">复制：源文件保留，只复制一份到目标目录（第一天建议用它）</string>

    <!-- 频率与文件名 -->
    <string name="edit_section_freq_name">频率与文件名</string>
    <string name="edit_interval">轮询间隔：%1$d 分钟</string>
    <string name="edit_label_extensions">扩展名白名单（逗号分隔）</string>
    <string name="edit_label_suffix">文件名后缀</string>
    <string name="edit_suffix_hint">填 {app} = 自动用来源 App 名（封面_{app}.png → 封面_起点读书.png）；填自己的文字 = 固定后缀（如 _拾图）；留空 = 不改文件名</string>
    <string name="edit_suffix_placeholder">{app}</string>
    <string name="edit_content_rename">改成按内容生成的文件名（15 位字母数字）</string>
    <string name="edit_content_rename_on_hint">同一个文件永远得到同一个名字，重复的图不会再多存一份。\n例：K7pQ2mVx9Rb4TzW%1$s.jpg（后面的后缀照上面填的来）</string>
    <string name="edit_content_rename_suffix_example">_起点读书</string>
    <string name="edit_content_rename_off_hint">关着：目标文件名沿用原来的名字，只在后面加你填的后缀</string>

    <!-- 按钮与保存校验 -->
    <string name="edit_save_as_template">存为模板</string>
    <string name="edit_cancel">取消</string>
    <string name="edit_save_and_start">保存并开始搬运</string>
    <string name="edit_default_template">我的模板</string>
    <string name="edit_field_src">源目录</string>
    <string name="edit_field_dst">目标目录</string>
    <string name="edit_list_separator">、</string>
    <string name="edit_missing_title">还差几项才能保存</string>
    <string name="edit_missing_body">请先填好：%1$s。\n\n目录点对应的「选择」按钮，从 /sdcard 开始一层层点进去；名称随你起，自己认得就行。</string>
    <string name="edit_got_it">知道了</string>

    <!-- 存为模板 -->
    <string name="edit_template_dialog_body">把这份设置存下来，以后新建规则时可以一键套用（存模板不会保存这条规则）。</string>
    <string name="edit_template_name_label">模板名字</string>
    <string name="edit_template_confirm">存下来</string>

    <!-- 两个确认对话框 -->
    <string name="edit_nested_title">目标目录在源目录里面</string>
    <string name="edit_nested_body">你选的源目录是 %1$s，目标目录 %2$s 在它里面。这种配法虽然不会再搬已搬好的文件（App 会自动跳过目标目录），但建议把目标放到源目录外面，规则更清楚、也更好撤回。确定要这样保存吗？</string>
    <string name="edit_nested_confirm">就这样保存</string>
    <string name="edit_nested_dismiss">回去改</string>
    <string name="edit_root_title">确定要搬整个存储？</string>
    <string name="edit_root_body">你把源目录选成了 /sdcard（整个手机存储）。保存后，手机里几乎所有图片都会按这条规则被搬走（移动模式下原图会离开原位）。如果只是想清理某个 App 的图片，请回去点进 Android/data/&lt;包名&gt;/… 再选一层。</string>
    <string name="edit_root_confirm">我知道，就这么办</string>
    <string name="edit_root_dismiss">回去重选</string>
</resources>
