    <string name="set_max_run_sec">单轮最长运行（秒）</string>
    <string name="set_stable_sec">文件稳定期（兜底等待，秒）</string>
    <string name="set_loop_window_min">重复抑制窗口（分钟）</string>
    <string name="set_loop_threshold">重复抑制阈值（次）</string>
