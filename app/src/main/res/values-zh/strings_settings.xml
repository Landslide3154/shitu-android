    <!-- 1. 存储访问 -->
    <string name="set_section_storage_access">存储访问</string>
    <string name="set_storage_granted_desc">已授权：普通目录不用 Shizuku；Android/data 仍需 Shizuku。</string>
    <string name="set_storage_not_granted_desc">未授权：打开后普通目录之间不用 Shizuku 也能搬；Android/data 仍需 Shizuku。</string>
    <string name="set_storage_granted">已授权</string>
    <string name="set_storage_open">去打开「所有文件访问」</string>
    <string name="set_help_storage_access">普通目录之间搬图靠它。打开「所有文件访问」后，不装 Shizuku 也能搬；Android/data 仍需要 Shizuku。</string>

    <!-- 2. 运行条件 -->
    <string name="set_section_run_conditions">运行条件</string>
    <string name="set_run_conditions_desc">从上到下先命中先算：允许条件（充电/亮屏/锁屏）命中就搬，阻止条件（锁屏超时/电量低）命中就停。充电放最上面 = 充电优先；全关 = 任何时候都搬。</string>
    <string name="set_run_only_charging">充电时搬</string>
    <string name="set_run_only_screen_on">亮屏时搬</string>
    <string name="set_run_only_screen_off">锁屏时搬</string>
    <string name="set_run_lock_timeout_on">锁屏超过 %1$d 分钟不搬</string>
    <string name="set_run_lock_timeout_off">锁屏超过 X 分钟不搬</string>
    <string name="set_run_lock_timeout_min">锁屏时长（分钟）</string>
    <string name="set_run_min_battery">电量低于 %1$d%% 时不搬</string>
    <string name="set_run_min_battery_off">电量低于 X% 时不搬</string>
    <string name="set_run_min_battery_pct">电量阈值</string>
    <string name="set_help_run_conditions">条件从上到下检查，先命中先算。充电放最上面 = 充电时怎么都搬；把「电量低」「锁屏超时」排到充电上面，它们也会拦住充电。</string>
    <string name="set_help_run_charging">只有插着充电器时才搬；把它排在「电量低」「锁屏超时」上面，充电会越过这两条限制。</string>
    <string name="set_help_run_screen_on">只有亮屏（且解锁）时才搬；优先级里谁先命中按谁算。</string>
    <string name="set_help_run_screen_off">只有锁屏/息屏时才搬；如果「锁屏超时」排在它上面，锁屏久了会先停。</string>
    <string name="set_help_run_battery">电量低于设定值时先不搬；如果「充电时搬」排在它上面，充电会越过去。数字范围 1–100。</string>

    <!-- 3. 检测时机 -->
    <string name="set_section_detection_timing">检测时机</string>
    <string name="set_fast_while_active">亮屏时加快检测</string>
    <string name="set_fast_interval_sec">检测间隔（秒）</string>
    <string name="set_fast_while_active_desc">亮屏时每几秒看一眼源目录。</string>
    <string name="set_settle_detect">写完就搬（不等稳定期）</string>
    <string name="set_settle_gap_sec">写完判定窗口（秒）</string>
    <string name="set_settle_detect_desc">大小和修改时间不再变，就立刻搬。</string>
    <string name="set_help_detection">决定多久看一眼源目录、文件写完多久后搬走。</string>
    <string name="set_help_fast_while_active">亮屏时每隔几秒快速看一眼目录，有变化才真正扫描，省电。</string>
    <string name="set_help_settle_detect">文件大小和修改时间不再变化就立刻搬，不用等满稳定期。</string>

