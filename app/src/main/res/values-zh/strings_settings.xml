    <!-- 2. 运行条件 -->
    <string name="set_section_run_conditions">运行条件</string>
    <string name="set_run_conditions_desc">可以同时开多个。插着充电器时不受电量条件限制（充电优先）；全关 = 任何时候都搬。</string>
    <string name="set_run_only_charging">充电时搬</string>
    <string name="set_run_only_screen_on">亮屏时搬</string>
    <string name="set_run_only_screen_off">熄屏时搬</string>
    <string name="set_run_min_battery">电量低于 %1$d%% 时不搬</string>
    <string name="set_run_min_battery_off">电量低于 __% 时不搬</string>
    <string name="set_run_min_battery_pct">电量阈值</string>
    <string name="set_help_run_conditions">可以同时开多个条件；全关 = 任何时候都搬。插着充电器时电量条件不生效。</string>
    <string name="set_help_run_charging">只有插着充电器时才搬；这时也不受电量条件限制。</string>
    <string name="set_help_run_screen_on">只有亮屏（且解锁）时才搬。和「熄屏时搬」同时开 = 任何时候都搬。</string>
    <string name="set_help_run_screen_off">只有熄屏时才搬，适合晚上放着充电时慢慢搬。</string>
    <string name="set_help_run_battery">电量低于设定值时先不搬；插着充电器时不受限制。数字范围 1–100。</string>

    <!-- 3. 检测时机 -->
    <string name="set_section_detection_timing">检测时机</string>
    <string name="set_fast_while_active">亮屏时加快检测</string>
    <string name="set_fast_interval_sec">检测间隔（秒）</string>
    <string name="set_fast_while_active_desc">亮屏时每几秒看一眼源目录。</string>
    <string name="set_settle_detect">写完就搬（不等稳定期）</string>
    <string name="set_settle_gap_sec">写完判定窗口（秒）</string>
